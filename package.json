{
  "name": "qhhoj-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api/main",
    "start:worker": "nest start worker",
    "start:prod:worker": "node dist/apps/worker/main",
    "start:bridge": "nest start bridge",
    "start:prod:bridge": "node dist/apps/bridge/main",
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/multipart": "10.1.2",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@simplewebauthn/server": "^13.3.3",
    "bullmq": "5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron": "^4.4.0",
    "fastify": "5.12.5",
    "htmlparser2": "10.1.0",
    "ioredis": "^5.11.1",
    "katex": "0.19.0",
    "markdown-it": "15.0.2",
    "mongoose": "^8.24.4",
    "mysql2": "^3.24.5",
    "nest-commander": "^3.21.0",
    "nodemailer": "^7.0.13",
    "playwright": "1.63.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "2.17.5",
    "saxes": "6.0.0",
    "uuid": "^11.1.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.12",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "^7.0.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "fastify": "5.12.5"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.4"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.(spec|e2e-spec)\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@libs/(common|database|auth|render|problems|judging|contests|community)(|/.*)$": "<rootDir>/libs/$1/src$2"
    },
    "testTimeout": 60000
  }
}
