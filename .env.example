# Everything else (SMTP, mail from, social login, Discord webhooks, pwned check, PDF limits, official contest mode, ban threshold, site time zone) is an admin setting: /api/internal/admin/settings
MONGO_URL=mongodb://localhost:27017/qhhoj?replicaSet=rs0
REDIS_URL=redis://localhost:6379
ENCRYPTION_KEY=
TOKEN_SECRET=
SITE_URL=http://localhost:5173
# Interface the api listens on; default 127.0.0.1 when NODE_ENV=production, else 0.0.0.0
LISTEN_HOST=
PORT=3000
LOG_LEVEL=info
# false, or trusted proxy addresses, e.g. loopback or 127.0.0.1,10.0.0.0/8
TRUST_PROXY=false
# Client IPs/CIDRs (IPv4/IPv6, comma-separated) allowed 512 live event streams instead of 16, e.g. a school lab behind one NAT address; empty = none
SSE_IP_ALLOWLIST=
COOKIE_SECURE=false
MEDIA_ROOT=./media
# Public prefix nginx serves MEDIA_ROOT under
MEDIA_URL=/media
# Shared volume with the judges: <PROBLEM_DATA_ROOT>/<code>/init.yml
PROBLEM_DATA_ROOT=./problem-data
# Rendered statement PDFs (api serves, worker writes)
PDF_CACHE_ROOT=./pdf-cache
# Worker PDF renders running at once
PDF_CONCURRENCY=2
# Contest data zips (api serves, worker writes); unset disables data download. Not under MEDIA_ROOT
CONTEST_DATA_ROOT=./contest-data
# User data export zips (api serves, worker writes); unset disables the export. Not under MEDIA_ROOT
USER_DATA_ROOT=./user-data
# Bridge: judges connect here (gRPC qhhoj.judge.v1). A non-loopback host needs JUDGE_BRIDGE_TLS_CERT and _KEY (PEM paths)
JUDGE_BRIDGE_HOST=127.0.0.1
JUDGE_BRIDGE_PORT=9999
# JUDGE_BRIDGE_TLS_CERT=/etc/qhhoj/bridge.crt
# JUDGE_BRIDGE_TLS_KEY=/etc/qhhoj/bridge.key
LEGACY_MYSQL_URL=mysql://root:root@localhost:3306/legacy
LEGACY_SECRET_KEY=
TEST_MYSQL_URL=mysql://root:root@localhost:3306
TEST_REDIS_URL=redis://127.0.0.1:6379/15
# npm run seed:e2e creates e2e_admin, e2e_user and problem e2e_sum, and seeds mail.smtpUrl to mailpit when unset; NODE_ENV must be test or development; passwords: E2E_ADMIN_PASSWORD, E2E_USER_PASSWORD; needs MONGO_URL, PROBLEM_DATA_ROOT, ENCRYPTION_KEY
