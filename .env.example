MONGO_URL=mongodb://localhost:27017/qhhoj?replicaSet=rs0
REDIS_URL=redis://localhost:6379
ENCRYPTION_KEY=
TOKEN_SECRET=
SITE_URL=http://localhost:5173
PORT=3000
LOG_LEVEL=info
# false, or trusted proxy addresses, e.g. loopback or 127.0.0.1,10.0.0.0/8
TRUST_PROXY=false
COOKIE_SECURE=false
PWNED_API_URL=https://api.pwnedpasswords.com
# Credentials in the URL must be percent-encoded (e.g. p%40ss)
SMTP_URL=smtp://localhost:1025
MEDIA_ROOT=./media
# Public prefix nginx serves MEDIA_ROOT under
MEDIA_URL=/media
# Shared volume with the judges: <PROBLEM_DATA_ROOT>/<code>/init.yml
PROBLEM_DATA_ROOT=./problem-data
# Rendered statement PDFs (api serves, worker writes)
PDF_CACHE_ROOT=./pdf-cache
# Worker PDF rendering: per-render timeout, largest accepted PDF, parallel renders
PDF_RENDER_TIMEOUT_MS=30000
PDF_MAX_BYTES=52428800
PDF_CONCURRENCY=2
# Contest data zips (api serves, worker writes); unset disables data download. Not under MEDIA_ROOT
CONTEST_DATA_ROOT=./contest-data
# MOSS user id; unset disables MOSS
MOSS_API_KEY=
# User data export zips (api serves, worker writes); unset disables the export. Not under MEDIA_ROOT
USER_DATA_ROOT=./user-data
# Official contest mode: non-superusers cannot edit their profile about or first name
OFFICIAL_CONTEST_MODE=false
# Bridge: judges connect here (DMOJ judge protocol)
JUDGE_BRIDGE_HOST=0.0.0.0
JUDGE_BRIDGE_PORT=9999
MAIL_FROM=
# Social login: a provider is enabled when both its id and secret are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LEGACY_MYSQL_URL=mysql://root:root@localhost:3306/legacy
LEGACY_SECRET_KEY=
TEST_MYSQL_URL=mysql://root:root@localhost:3306
TEST_REDIS_URL=redis://127.0.0.1:6379/15

# Disqualifications that ban an account (0: never)
CONTEST_BAN_AFTER_DISQUALIFICATIONS=0
