# Install to /etc/containers/systemd/ (rootful podman); the quadlet generator turns it into qhhoj-api.service.
# The image tag :current is moved only by qhhoj-deploy.
[Unit]
Description=QHHOJ api
After=network-online.target mongod.service redis-server.service
Wants=network-online.target
PartOf=qhhoj.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Container]
ContainerName=qhhoj-api
Image=ghcr.io/qhhoj/backend-v2:current
Pull=never
Network=host
User=987
Group=987
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
EnvironmentFile=/etc/qhhoj/env
Environment=APP=api NODE_ENV=production
Volume=/srv/qhhoj:/srv/qhhoj
LogDriver=journald

[Service]
Restart=always
RestartSec=3
TimeoutStopSec=30
# Shared host: a leak OOM-kills this unit, not the old site. Reasoning in docs/decisions.md.
MemoryHigh=1536M
MemoryMax=2G

[Install]
WantedBy=qhhoj.target
