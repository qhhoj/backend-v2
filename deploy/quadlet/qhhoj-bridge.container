# Install to /etc/containers/systemd/ (rootful podman); the quadlet generator turns it into qhhoj-bridge.service.
# The image tag :current is moved only by qhhoj-deploy.
[Unit]
Description=QHHOJ judge bridge (exactly one instance)
After=network-online.target mongod.service redis-server.service
Wants=network-online.target
PartOf=qhhoj.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Container]
ContainerName=qhhoj-bridge
Image=ghcr.io/qhhoj/backend-v2:current
Pull=never
Network=host
User=991
Group=991
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
EnvironmentFile=/etc/qhhoj/env
Environment=APP=bridge NODE_ENV=production
Volume=/srv/qhhoj/problem-data:/srv/qhhoj/problem-data:ro
Volume=/etc/qhhoj/bridge-tls:/etc/qhhoj/bridge-tls:ro
LogDriver=journald

[Service]
Restart=always
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=qhhoj.target
