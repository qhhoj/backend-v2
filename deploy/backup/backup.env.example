# /etc/qhhoj/backup.env (root:root, mode 600): read by qhhoj-backup and qhhoj-backup-restore-test (RUNBOOK "Backups").
# Shell syntax: single-quote values with special characters. Keep RESTIC_PASSWORD in the offline secret store too:
# without it no snapshot can be read.
RESTIC_PASSWORD=CHANGE
# The qhhoj-backup user (role `backup`, RUNBOOK "Backups" step 2). The password stays out of the URL: it is handed to
# mongodump in a config file, so it never shows in a process list or in a connection error in the journal.
MONGO_BACKUP_URL='mongodb://qhhoj-backup@127.0.0.1:27017/?authSource=admin&replicaSet=rs0'
MONGO_BACKUP_PASSWORD=CHANGE
# 1: point-in-time dump with --oplog (needs a replica set and the backup role); 0: plain dump.
MONGO_OPLOG=1
# The database restore-test.sh compares.
MONGO_DB=qhhoj

# Local repository: the database only.
LOCAL_REPO=/backup/restic
# A local run is refused below this much free space (GiB) on the repository's filesystem.
LOCAL_MIN_FREE_GB=3

# Offsite repository: the database and DATA_PATHS. Empty = no offsite copy and NO backup of the files.
# Any restic backend, e.g. s3:https://s3.example.com/bucket/qhhoj, b2:bucket:qhhoj, sftp:user@host:/srv/restic/qhhoj,
# rclone:remote:qhhoj; put the backend's credentials here too (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, B2_ACCOUNT_ID/B2_ACCOUNT_KEY, ...).
OFFSITE_REPO=
# Space-separated directories backed up to OFFSITE_REPO (pdf-cache is a cache and is left out).
DATA_PATHS='/srv/qhhoj/problem-data /srv/qhhoj/media /srv/qhhoj/contest-data /srv/qhhoj/user-data'

# Optional healthchecks.io-style URL: pinged at start (/start), on success, and on failure (/fail).
HEALTHCHECK_URL=

# restore-test.sh: scratch directory for the throwaway mongod, its port, the allowed count drift, and the space that must
# stay free beyond the archive's size (a supervised run that removes its scratch, so a lower floor than the backup's).
RESTORE_TEST_DIR=/backup/restore-test
RESTORE_TEST_PORT=27999
RESTORE_TEST_TOLERANCE_PCT=2
RESTORE_TEST_MIN_FREE_GB=1
