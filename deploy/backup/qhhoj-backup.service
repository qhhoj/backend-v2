# qhhoj-backup.service: one run of /usr/local/sbin/qhhoj-backup, started by qhhoj-backup.timer (RUNBOOK "Backups").
# The site and the local judge share this host, so the run is capped: CPUQuota and MemoryMax are the hard limits;
# Nice and the batch CPU policy yield to everything else; IOSchedulingClass=idle and IOWeight act only under the BFQ
# I/O scheduler (cat /sys/block/*/queue/scheduler). A failed run leaves the unit failed (systemctl --failed).
[Unit]
Description=QHHOJ nightly backup (restic)
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/qhhoj-backup
# A oneshot has no start timeout by default: a stalled backend would keep the unit activating, the timer would skip
# every later night and nothing would show failed. 12h leaves room for the first offsite upload of problem-data; a killed
# run leaves a stale restic lock, which the next run removes.
TimeoutStartSec=12h
Nice=19
CPUSchedulingPolicy=batch
IOSchedulingClass=idle
IOWeight=10
CPUQuota=100%
# Go (restic, mongodump) starts one thread per host CPU; under the quota more threads only queue.
Environment=GOMAXPROCS=2
MemoryHigh=1536M
MemoryMax=2G
CacheDirectory=qhhoj-backup
CacheDirectoryMode=0700
# The partial snapshots still to forget and the last check time (qhhoj-backup-lib.sh).
StateDirectory=qhhoj-backup
StateDirectoryMode=0700
RuntimeDirectory=qhhoj-backup
RuntimeDirectoryMode=0700
UMask=0077
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadOnlyPaths=/srv/qhhoj
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
