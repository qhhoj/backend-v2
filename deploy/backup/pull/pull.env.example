# ~/.config/qhhoj-backup/pull.env (mode 600): read by qhhoj-pull on the owner's laptop (RUNBOOK "Backups" -> "Pull copy").
# Shell syntax: single-quote values with special characters.
# The QHHOJ host (an address or a Host alias from ~/.ssh/config) and the account its one key logs in as.
# The real address is in the operator's private notes and the DEPLOY_HOST repo secret, never in this repo.
SERVER='<production-host>'
SSH_USER=qhhoj-pull
# The dedicated key (ssh-keygen -t ed25519 -f ~/.ssh/qhhoj-pull); the host lets it run only qhhoj-pull-serve.
SSH_KEY=$HOME/.ssh/qhhoj-pull
# The restic repository's password, one line (mode 600). Keep a copy offline: without it no snapshot can be read.
RESTIC_PASSWORD_FILE=$HOME/.config/qhhoj-backup/restic-password
# The restic repository (database and files) and the rsync mirror of the data roots that feeds the files snapshots.
REPO=$HOME/qhhoj-backups/restic
MIRROR=$HOME/qhhoj-backups/mirror
# A run is refused (and fails) below this much free space (GiB) on the repository's filesystem.
MIN_FREE_GB=20
