[Unit]
Description=QHHOJ judge bridge (exactly one instance)
After=network-online.target mongod.service redis.service
Wants=network-online.target
PartOf=qhhoj.target

[Service]
User=qhhoj
WorkingDirectory=/opt/qhhoj/backend
EnvironmentFile=/etc/qhhoj/env
ExecStart=/usr/bin/node dist/apps/bridge/main
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=qhhoj.target
