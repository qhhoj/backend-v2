[Unit]
Description=QHHOJ api
After=network-online.target mongod.service redis-server.service
Wants=network-online.target
PartOf=qhhoj.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
User=qhhoj
WorkingDirectory=/opt/qhhoj/backend
Environment=NODE_ENV=production
EnvironmentFile=/etc/qhhoj/env
ExecStart=/usr/bin/node dist/apps/api/main
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
# Edit if the data roots live elsewhere
ReadWritePaths=/srv/qhhoj
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0027

[Install]
WantedBy=qhhoj.target
