# /etc/qhhoj/env (mode 600, owner root). Read by the api, bridge and worker containers through podman `--env-file`: plain `KEY=value` lines, no quotes, no `export`, no inline comments.
# Everything else (SMTP, social login, Discord webhooks, PDF limits, ...) is an admin setting, not env.

# MongoDB replica set connection string (transactions need a replica set)
MONGO_URL=mongodb://qhhoj:CHANGE_ME@127.0.0.1:27017/qhhoj?replicaSet=rs0&authSource=admin
# Redis >= 7 (rate limiter, events, bridge command stream)
REDIS_URL=redis://127.0.0.1:6379
# Secret for encrypting stored values; generate once with `openssl rand -hex 32`, never rotate without a plan
ENCRYPTION_KEY=
# Secret for signing tokens; `openssl rand -hex 32`
TOKEN_SECRET=
# Keys and signs the Redis session records (at least 32 bytes; the api refuses to boot without it); `openssl rand -hex 32`. Changing it ends every session
SESSION_SECRET=
# Public origin, no trailing slash; the cookie Origin check, OAuth callbacks and links in mails and feeds use it
SITE_URL=https://oj.example.org
# Interface the api listens on (nginx upstream); blank = 127.0.0.1 in production
LISTEN_HOST=127.0.0.1
# api listen port (nginx upstream); keep it closed to everything but loopback
PORT=3000
# fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info
# nginx runs on this host and is the only client of the api
TRUST_PROXY=loopback
# Client IPs/CIDRs allowed 512 live event streams instead of 16 (school lab behind one NAT); empty = none
SSE_IP_ALLOWLIST=
# Cookies get the Secure flag; true behind HTTPS
COOKIE_SECURE=true
# Uploaded files; nginx serves it at MEDIA_URL. The four roots below must NOT be under it
MEDIA_ROOT=/srv/qhhoj/media
# Public prefix nginx serves MEDIA_ROOT under
MEDIA_URL=/media
# Shared with the judges: <root>/<code>/init.yml
PROBLEM_DATA_ROOT=/srv/qhhoj/problem-data
# Rendered statement PDFs (api serves, worker writes)
PDF_CACHE_ROOT=/srv/qhhoj/pdf-cache
# Worker PDF renders running at once (about 2 GB of memory each); shared 13 GiB host: one PDF render at a time
PDF_CONCURRENCY=1
# Contest data zips; unset disables data download. Must not overlap USER_DATA_ROOT
CONTEST_DATA_ROOT=/srv/qhhoj/contest-data
# User data export zips; unset disables the export
USER_DATA_ROOT=/srv/qhhoj/user-data
# Bridge: judges connect here (gRPC over TLS; judges pin the CA that signed this certificate). Bind to the private interface judges reach, firewall the port
# CHANGE: private interface judges reach (0.0.0.0 = all)
JUDGE_BRIDGE_HOST=10.0.0.1
JUDGE_BRIDGE_PORT=9999
# CHANGE: PEM certificate chain and key of the judge port (readable by the bridge user only)
JUDGE_BRIDGE_TLS_CERT=/etc/qhhoj/bridge-tls/cert.pem
JUDGE_BRIDGE_TLS_KEY=/etc/qhhoj/bridge-tls/key.pem
